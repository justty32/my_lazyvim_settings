# 測試 evaluator 本身，不靠程序隔離掩蓋初始化式被執行的問題。
(defn main [script repo]
  (def evaluator (dofile (string repo "/src/eval.janet")))
  (def evaluate (get-in evaluator ['eval-buffer :value]))
  (def marker (string repo "/unexpected-initializer.txt"))
  (def effect (string/format `(do (spit %j "executed") 42)` marker))
  (each declaration ["def" "var" "def-" "var-" ]
    (def [errors env] (evaluate (string/format "(%s probe %s) (+ probe 1)" declaration effect)))
    (assert (empty? errors) (string/format "unexpected diagnostics (%s): %q" declaration errors))
    (assert (env 'probe) "binding must remain available")
    (assert (not (os/stat marker)) "runtime initializer was executed"))
  (each initializer [(string "[" effect "]")
                     (string "{:nested " effect "}")
                     (string "@[" effect "]")]
    (def [errors env] (evaluate (string "(def data " initializer ")")))
    (assert (empty? errors))
    (assert (env 'data))
    (assert (not (os/stat marker))))
  (def [errors env] (evaluate (string "(def [a b] " effect ") (+ a b)")))
  (assert (empty? errors))
  (assert (env 'a))
  (assert (env 'b))
  (assert (not (os/stat marker)))
  (def [errors env] (evaluate `(def answer 42) (defn add-one "Add one." [x] (+ x 1))`))
  (assert (empty? errors))
  (assert (= ((env 'answer) :value) 42))
  (assert (= (((env 'add-one) :value) 41) 42))
  (assert (not (empty? (first (evaluate "(+ 1")))))
  (assert (not (empty? (first (evaluate "unknown-symbol")))))
  (print "PASS: declarations, nested values, destructuring, completion bindings, functions and diagnostics"))
